cabal-version:      3.12
name:               anima2d
version:            0.1.0.0
synopsis:           A self-hosted 2D animation studio for the browser and Apple Pencil
homepage:           https://example.com/abdivasiyev/anima2D
license:            Apache-2.0
license-file:       LICENSE
author:             Asliddin Abdivasiyev
maintainer:         asliddin.abdivasiyev@gmail.com
category:           Graphics
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options:
        -Wall
        -Wincomplete-uni-patterns
        -Wincomplete-record-updates
        -Wmissing-export-lists
        -Wpartial-fields
        -Werror
    default-language: GHC2024
    default-extensions:
        OverloadedStrings
        OverloadedRecordDot
        DuplicateRecordFields
        NoFieldSelectors
        DeriveAnyClass
        LambdaCase
        DerivingVia

library
    import:           warnings
    exposed-modules:  Anima.Config
                    , Anima.Server
                    , Anima.Store
                    , Anima.Types.Parse
                    , Anima.Types.Project
    hs-source-dirs:   src
    build-depends:    base >=4.20 && <5
                    , aeson
                    , bytestring
                    , directory
                    , filepath
                    , http-api-data
                    , optparse-applicative
                    , servant-server
                    , text
                    , wai
                    , wai-app-static

executable anima2d
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N2 -A16m"
    build-depends:    base >=4.20 && <5
                    , anima2d
                    , optparse-applicative
                    , warp

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    other-modules:    Anima.Gen
                    , Anima.StoreSpec
                    , Anima.Types.ProjectSpec
    build-depends:    base >=4.20 && <5
                    , anima2d
                    , aeson
                    , bytestring
                    , filepath
                    , hspec
                    , QuickCheck
                    , temporary
                    , text
