cabal-version:      3.12
name:               anima2d-desktop
version:            0.1.0.0
synopsis:           The anima2D editor as a native GTK3 application
license:            Apache-2.0
category:           Graphics
build-type:         Simple
extra-source-files: test/freehand-cases.json

common warnings
    ghc-options:
        -Wall
        -Wincomplete-uni-patterns
        -Wincomplete-record-updates
        -Wmissing-export-lists
        -Wpartial-fields
        -Werror
    default-language: GHC2024
    default-extensions:
        OverloadedStrings
        OverloadedRecordDot
        OverloadedLabels
        DuplicateRecordFields
        NoFieldSelectors
        LambdaCase

library
    import:           warnings
    exposed-modules:  Anima.Desktop.Freehand
                    , Anima.Desktop.Random
                    , Anima.Desktop.Draw
                    , Anima.Desktop.Scene
                    , Anima.Desktop.Backend
                    , Anima.Desktop.Config
                    , Anima.Desktop.Ui
                    , Anima.Desktop.Make
                    , Anima.Desktop.Fill
                    , Anima.Desktop.Geometry
                    , Anima.Desktop.Icons
                    , Anima.Desktop.Style
                    , Anima.Desktop.Video
    hs-source-dirs:   src
    build-depends:    base >=4.20 && <5
                    , anima2d
                    , aeson
                    , bytestring
                    , case-insensitive
                    , containers
                    , directory
                    , filepath
                    , gi-gdk3
                    , gi-gdkpixbuf
                    , gi-glib
                    , gi-gtk3
                    , haskell-gi-base
                    , http-client
                    , http-client-tls
                    , http-types
                    , process
                    , vector
                    , gi-cairo-render
                    , gi-pango
                    , gi-pangocairo
                    , gi-cairo-connector
                    , text

executable anima2d-desktop
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts
    build-depends:    base >=4.20 && <5
                    , anima2d
                    , anima2d-desktop
                    , aeson
                    , bytestring
                    , containers

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >=4.20 && <5
                    , aeson
                    , anima2d
                    , anima2d-desktop
                    , bytestring
                    , containers
                    , text

-- Drives the real window; needs a display session, so it runs on demand (`just desktop-ui`).
test-suite ui
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Ui.hs
    hs-source-dirs:   test
    ghc-options:      -threaded
    build-depends:    base >=4.20 && <5
                    , anima2d
                    , anima2d-desktop
                    , directory
                    , filepath
                    , gi-cairo-connector
                    , gi-cairo-render
                    , gi-gtk3
                    , process
                    , text
